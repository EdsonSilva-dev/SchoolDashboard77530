@page "/schools"

@using SchoolDashboard77530.Models
@using SchoolDashboard77530.Services
@inject SchoolService SchoolService

<PageTitle>Schools</PageTitle>

<h1>School Directory</h1>

@if (schools == null)
{
    <p>Loading schools...</p>
}
else if (schools.Count == 0)
{
    <p>No schools found.</p>
}
else
{
    <div class="row">
        @foreach (var school in schools)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            @school.SchoolName
                        </h5>

                        <p class="card-text">
                            <strong>School ID:</strong>
                            @school.SchoolId
                        </p>

                        <p class="card-text">
                            <strong>Address:</strong>
                            @school.Address
                        </p>

                        <p class="card-text">
                            <strong>Phone:</strong>
                            @school.PhoneNo
                        </p>

                        <p class="card-text">
                            <strong>Email:</strong>
                            @school.EmailAddress
                        </p>

                        <p class="card-text">
                            <strong>Proprietor:</strong>
                            @school.ProprietorFullName
                        </p>

                        <p class="card-text">
                            <strong>Head:</strong>
                            @school.HeadFullName
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<School>? schools;

    protected override async Task OnInitializedAsync()
    {
        schools = await SchoolService.GetSchoolsAsync();
    }
}