@page "/schools"
@rendermode InteractiveServer

@using SchoolDashboard77530.Models
@using SchoolDashboard77530.Services
@inject SchoolService SchoolService

<PageTitle>Schools</PageTitle>

<h1>School Directory</h1>

@if (schools == null)
{
    <p>Loading schools...</p>
}
else if (schools.Count == 0)
{
    <p>No schools found.</p>
}
else
{
    <div class="row">
        @foreach (var school in schools)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <SchoolCard School="school"
                            OnSelect="HandleSchoolSelected" />
            </div>
        }
    </div>
}


@if (selectedSchool is not null)
{
    <SchoolDetails School="selectedSchool" />
}
else
{
    <p class="text-muted">
        Select a school to view its details.
    </p>
}


@code {
    private List<SchoolDashboard77530.Models.School>? schools;

    private SchoolDashboard77530.Models.School? selectedSchool;

    protected override async Task OnInitializedAsync()
    {
        schools = await SchoolService.GetSchoolsAsync();
    }

    private void HandleSchoolSelected(
        SchoolDashboard77530.Models.School school)
    {
        selectedSchool = school;
    }
}